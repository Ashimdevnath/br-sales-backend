{
  "name": "clothesales-backend",
  "version": "1.0.0",
  "description": "ClotheSales Billing Software — Node.js + Express + Prisma + PostgreSQL backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
